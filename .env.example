# Copy to .env and fill in. Never commit .env.

# --- Secrets ------------------------------------------------------------------
# Bearer token the Discord bot sends (STREAM_CONTROL_TOKEN in the bot's .env). openssl rand -hex 32
CONTROL_API_TOKEN=
# Internal account the delay players publish the delayed feeds with. openssl rand -hex 16
DELAY_PASSWORD=

# --- Public addresses (what ends up in players' and casters' links) -----------
# Browser pages (reverse proxy -> this host's port 8889)
PUBLIC_BROWSER_BASE=https://stream.acheros.be
# SRT (router -> node 2 -> this container, UDP 8890)
PUBLIC_SRT_HOST=stream.acheros.be
PUBLIC_SRT_PORT=8890
# Public IP for WebRTC media (UDP 8189 forwarded to this container)
PUBLIC_IP=
# Optional SRT encryption passphrase (10-79 characters), shared by publishers and casters
SRT_PASSPHRASE=

# --- Where things are published on this host ----------------------------------
# Address the bot reaches the control API on (e.g. this container's IP). The firewall limits it to the bot.
CONTROL_BIND=127.0.0.1
# Address the reverse proxy reaches the WebRTC pages on
MEDIA_HTTP_BIND=127.0.0.1

# --- Storage --------------------------------------------------------------------
# Host folders (SSD): recordings ring buffer and the control database/status files
HOST_RECORDINGS_DIR=./recordings
HOST_DATA_DIR=./data

# --- Delay ------------------------------------------------------------------------
DEFAULT_DELAY_MINUTES=30

# --- Archive (copy to node 1) -----------------------------------------------------
# rsync destination over SSH; empty = keep recordings local only.
# The private key goes in ./secrets/archive_key (its public key in node 1's authorized_keys).
ARCHIVE_TARGET=
ARCHIVE_SSH_PORT=22
ARCHIVE_INTERVAL_SECONDS=60
LOCAL_RETAIN_MARGIN_MINUTES=15
LOCAL_RETAIN_MAX_HOURS=48
